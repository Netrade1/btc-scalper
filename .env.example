# ── Required ────────────────────────────────────────────────────────────────
# Secret token used to authenticate TradingView webhook requests.
# Set the same value in:
#   1. This file (WEBHOOK_SECRET)
#   2. The X-Webhook-Token HTTP header configured in TradingView alert settings
#   3. The webhook_secret input in the Pine Script (optional fallback in body)
WEBHOOK_SECRET=your_super_secret_token_here

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, fine for single-server deployments):
DATABASE_URL=sqlite:////app/data/btc_scalper.db

# PostgreSQL example (recommended for multi-worker production):
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/btc_scalper

# ── Dashboard alerts ─────────────────────────────────────────────────────────
# Fire an alert when ruin probability reaches this fraction (0–1).
RUIN_PROBABILITY_ALERT_THRESHOLD=0.10
